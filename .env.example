# ==========================================================================
# CLERK AUTHENTICATION
# ==========================================================================
# Get these from https://dashboard.clerk.com/apps
# 
# 1. Sign up for a Clerk account (free)
# 2. Create a new application
# 3. Copy your API keys from the "API Keys" page

# Your public Clerk Publishable Key (safe to expose in browser)
# Starts with: pk_test_ (development) or pk_live_ (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Your secret Clerk key (keep private, only on server)
# Starts with: sk_test_ (development) or sk_live_ (production)
CLERK_SECRET_KEY=sk_test_your_secret_key_here


# ==========================================================================
# CLERK CONFIGURATION (Optional but Recommended)
# ==========================================================================

# URL to your sign-in page
# Default: /sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# URL to your sign-up page
# Default: /sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# URL to redirect to after successful sign-in
# Default: /
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin

# URL to redirect to after successful sign-up
# Default: /
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin


# ==========================================================================
# DATABASE (Future use)
# ==========================================================================
# When you're ready to connect a database, add your connection strings here

# DATABASE_URL=postgresql://user:password@localhost:5432/crazzzy
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=xxx


# ==========================================================================
# API ENDPOINTS (Future use)
# ==========================================================================

# Your backend API endpoint
# NEXT_PUBLIC_API_URL=http://localhost:3001

# For production
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com


# ==========================================================================
# STRIPE (Optional - for payments)
# ==========================================================================

# Get from: https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx


# ==========================================================================
# ANALYTICS (Optional)
# ==========================================================================

# For tracking with Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=xxx

# For other analytics services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-xxx


# ==========================================================================
# FEATURE FLAGS
# ==========================================================================

# Show/hide features in development
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_PREMIUM_FEATURES=false
